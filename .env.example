# Copia este archivo como .env y pega los valores de Supabase:
# Dashboard → Project Settings → API (o "Connect").
# Vite solo expone al navegador variables que empiezan por VITE_.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica

# NUNCA pongas aquí la "service_role" key: este archivo termina en el navegador.
